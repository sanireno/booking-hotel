APP_HOST=127.0.0.1
APP_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking_hotel
DATABASE_MAX_CONNECTIONS=5
# Set this to a random secret, e.g. the output of: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=3600
RUST_LOG=booking_hotel=debug,tower_http=debug
